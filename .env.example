# ═══════════════════════════════════════════════════════════════════
#  MediLink AI — Environment Variables TEMPLATE
#  Copy this file to `.env.local` and fill in the real values:
#      cp .env.example .env.local
#  Never commit real secrets. Values are loaded by Next.js
#  automatically for `next dev` / `next build` / `next start`.
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────
# OpenRouter API key — powers the "Dr MediLink" chatbot
# Get one at: https://openrouter.ai/settings/keys
# Example: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=

# ── OPTIONAL ─────────────────────────────────────────────────────
# MediLink WhatsApp number used by pharmacy orders and SOS sharing.
# Digits only, with country code, no "+" and no spaces.
# Defaults to 8801811389672 when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801811389672

# Per-IP rate limit for /api/chat: max requests per minute (default 12).
# Keeps the free-model demo stable against burst traffic.
CHAT_RATE_LIMIT_PER_MIN=12

# ═══════════════════════════════════════════════════════════════════
#  v3 FEATURE PACK — Vision / OCR, Maps, WhatsApp Business, Web Push
# ═══════════════════════════════════════════════════════════════════

# ── Vision / OCR (Tencent Hunyuan Vision) ─────────────────────────
# Model used for prescription & test-report image understanding.
# This is the designated OCR model for the whole platform.
VISION_MODEL_ID=minimax/minimax-m3.1-flash:free

# OpenAI-compatible gateway that serves the vision model.
VISION_BASE_URL=https://openrouter.ai/api/v1

# Key for the vision gateway. Falls back to OPENROUTER_API_KEY when unset.
VISION_API_KEY=

# Optional fallback model, used when the primary vision model is
# unavailable on the configured gateway.
VISION_FALLBACK_MODEL_ID=nvidia/nemotron-3.5-super-vl:free

# Max vision calls per hour per IP (default 60).
VISION_RATE_LIMIT_PER_HOUR=60

# ── Google Maps ────────────────────────────────────────────────────
# SERVER-ONLY key. Enables the Routes, Directions and Geocoding APIs.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
# Enable "Routes API" and "Directions API" in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# Default travel mode for hospital routing (DRIVE|WALK|BICYCLE|TWO_WHEELER).
GOOGLE_MAPS_TRAVEL_MODE=DRIVE

# ── WhatsApp Business API (optional, v3.1) ────────────────────────
# v2 uses plain wa.me deep links and needs none of these.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_DOCTOR_BOOKING=doctor_booking

# ── Web Push (optional, v3.1) ─────────────────────────────────────
# Needed only for reliable background delivery when the app is closed.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:dev@medilink.com.bd

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
